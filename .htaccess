RewriteEngine On

# Proxy requests to /api/ to the local server running on port 3000
RewriteCond %{REQUEST_URI} ^/api/.*$
RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]

# Bloquear el listado de directorios
Options -Indexes

# Reescribir URLs para ocultar la extensión .html
# Si se solicita una URL sin extensión y existe el archivo .html, redirige a ese archivo
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Asegurar que 'form' sin extensión redirija a 'form.html'
RewriteCond %{REQUEST_URI} ^(.*/)?form$ [NC]
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*/)?form$ $1form.html [L]

# Excepción para archivos estáticos (imágenes, CSS, JS, etc.)
# Permitir acceso a archivos con extensiones .jpg, .jpeg, .png, .gif, .css, .js
RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|css|js)$ [NC]
RewriteRule ^(.*)$ - [L]

# Denegar acceso directo a archivos que no sean "form.html", "form" o "conexion.php" (sin extensión)
# En cualquier nivel de directorio
RewriteCond %{REQUEST_URI} !^(.*/)?(form|conexion)(?:\.html|\.php)?$ [NC]
RewriteRule ^(.*)$ - [R=403,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php80” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
