<IfModule mod_rewrite.c>
    RewriteEngine On

    # Asegura que todos los métodos HTTP sean aceptados
    <Limit GET POST PUT DELETE OPTIONS>
        Require all granted
    </Limit>

    # Configuración de acceso a archivos estáticos
    RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|css|js|html|php)$ [NC]
    RewriteRule ^ - [L]

    # Bloquear el listado de directorios
    Options -Indexes

    # Reescribir URLs para ocultar la extensión .html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Reescribir URLs para formulario, proxy y API con permisos completos
    RewriteRule ^test/form/?$ /test/form [L]
    RewriteRule ^test/proxy/?$ /test/proxy [L]
    RewriteRule ^test/api-test/?$ /test/api-test [L]

    # php -- BEGIN cPanel-generated handler, do not edit
    <IfModule mime_module>
      AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
    </IfModule>
    # php -- END cPanel-generated handler, do not edit
</IfModule>
